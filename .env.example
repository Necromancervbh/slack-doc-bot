# =============================================================================
#  Slack Doc Bot — Environment Variables
#  Author: Vaibhav Shukla
#
#  1. Copy this file: cp .env.example .env
#  2. Fill in your actual credentials below
#  3. NEVER commit .env to git (it's already in .gitignore)
# =============================================================================

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# ── Pinecone ──────────────────────────────────────────────────────────────────
# Get from: https://app.pinecone.io
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=slack-doc-bot
PINECONE_ENVIRONMENT=us-east-1

# ── Slack ─────────────────────────────────────────────────────────────────────
# Get from: https://api.slack.com/apps → Your App → OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Get from: Your App → Basic Information → App-Level Tokens
# Requires connections:write scope
SLACK_APP_TOKEN=xapp-your-app-token-here

# Get from: Your App → Basic Information → Signing Secret
SLACK_SIGNING_SECRET=your-signing-secret-here

# ── RAG Tuning ────────────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=4
DOCS_DIRECTORY=docs
