# =============================================================================
#  Slack Doc Bot - Environment Variables
#  Author: Vaibhav Shukla
#
#  1. Copy this file: cp .env.example .env
#  2. Fill in your actual credentials
#  3. NEVER commit .env to git (already in .gitignore)
# =============================================================================

# -- OpenAI -------------------------------------------------------------------
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# -- Pinecone -----------------------------------------------------------------
# Get from: https://app.pinecone.io
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=slack-doc-bot
PINECONE_ENVIRONMENT=us-east-1

# -- Slack --------------------------------------------------------------------
# Bot Token: Your App > OAuth & Permissions > Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# App Token: Your App > Basic Information > App-Level Tokens (connections:write scope)
SLACK_APP_TOKEN=xapp-your-app-token-here

# Signing Secret: Your App > Basic Information > App Credentials
SLACK_SIGNING_SECRET=your-signing-secret-here

# -- RAG Tuning ---------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=4
DOCS_DIRECTORY=docs

# -- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO

# -- Feature Flags ------------------------------------------------------------
ENABLE_SOURCE_CITATIONS=true
ENABLE_DM_SUPPORT=true
MAX_QUESTION_LENGTH=500
